{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContactDock",
  "version": "0.1.0",
  "identifier": "io.github.vaibhavhiwale.contactdock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ContactDock",
        "width": 900,
        "height": 700,
        "minWidth": 700,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
